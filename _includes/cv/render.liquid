{% assign cv = site.data.cv.cv %}
<style>
  .yp-cv {
    --yp-ink: #152b46;
    --yp-muted: #506176;
    --yp-accent: #087e83;
    --yp-line: #dce6ec;
    --yp-surface: #ffffff;
    --yp-soft: #f1f7f9;
    color: var(--yp-ink);
    font-size: 1rem;
    line-height: 1.65;
  }
  html[data-theme='dark'] .yp-cv {
    --yp-ink: #e5edf7;
    --yp-muted: #aabbd0;
    --yp-accent: #6ad9d1;
    --yp-line: #33475b;
    --yp-surface: #172839;
    --yp-soft: #203548;
  }
  .yp-cv * {
    box-sizing: border-box;
  }
  .yp-cv a {
    color: var(--yp-accent);
  }
  .yp-cv a:focus-visible {
    outline: 3px solid var(--yp-accent);
    outline-offset: 5px;
  }
  .yp-cv .yp-hero {
    background: #142c46;
    color: #ffffff;
    padding: clamp(1.5rem, 5vw, 3rem);
    border-radius: 1.25rem;
    border-top: 5px solid #32c4b8;
    margin-bottom: 2.75rem;
  }
  .yp-cv .yp-kicker {
    color: #83e5db;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 1rem;
  }
  .yp-cv h1 {
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    line-height: 1.12;
    font-weight: 700;
    letter-spacing: -0.045em;
    color: #fff;
    margin: 0 0 0.75rem;
  }
  .yp-cv .yp-role {
    color: #bce8e6;
    font-size: 1.125rem;
    margin: 0 0 1.25rem;
  }
  .yp-cv .yp-summary {
    color: #e0e9f2;
    margin: 0;
    max-width: 62ch;
  }
  .yp-cv .yp-contact {
    border-top: 1px solid #3d5268;
    padding-top: 1.1rem;
    margin-top: 1.5rem;
  }
  .yp-cv .yp-contact a {
    color: #a7f3e9;
    text-decoration: underline;
    text-underline-offset: 4px;
    overflow-wrap: anywhere;
  }
  .yp-cv .yp-section {
    margin: 0 0 2.75rem;
    scroll-margin-top: 6rem;
  }
  .yp-cv .yp-section-heading {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    border-bottom: 2px solid var(--yp-line);
    padding-bottom: 0.85rem;
    margin-bottom: 1.25rem;
  }
  .yp-cv .yp-number {
    color: var(--yp-accent);
    font-size: 0.875rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .yp-cv h2 {
    color: var(--yp-ink);
    font-size: clamp(1.4rem, 2.8vw, 1.85rem);
    letter-spacing: -0.025em;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
    scroll-margin-top: 6rem;
  }
  .yp-cv h3 {
    color: var(--yp-ink);
    font-size: 1.0625rem;
    font-weight: 650;
    line-height: 1.4;
    margin: 0 0 0.4rem;
  }
  .yp-cv .yp-timeline {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--yp-line);
  }
  .yp-cv .yp-timeline:first-child {
    padding-top: 0;
  }
  .yp-cv .yp-timeline:last-child {
    border-bottom: 0;
  }
  .yp-cv .yp-date {
    color: var(--yp-accent);
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .yp-cv .yp-date span {
    display: inline-block;
    padding: 0.35rem 0.6rem;
    background: var(--yp-soft);
    border-radius: 0.35rem;
  }
  .yp-cv .yp-detail {
    min-width: 0;
    border-left: 2px solid var(--yp-line);
    padding-left: 1.25rem;
  }
  .yp-cv .yp-org {
    color: var(--yp-accent);
    font-size: 0.9375rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
  }
  .yp-cv .yp-meta {
    color: var(--yp-muted);
    font-size: 0.875rem;
    margin: 0.25rem 0;
  }
  .yp-cv .yp-description {
    margin: 0.6rem 0 0;
  }
  .yp-cv .yp-highlights {
    margin: 0.75rem 0 0;
    padding-left: 1.2rem;
  }
  .yp-cv .yp-highlights li {
    padding-left: 0.15rem;
    margin-bottom: 0.3rem;
  }
  .yp-cv .yp-highlights li::marker {
    color: var(--yp-accent);
  }
  .yp-cv .yp-award {
    padding: 1rem 1.15rem;
    border-left: 3px solid var(--yp-accent);
    margin-bottom: 0.65rem;
    background: var(--yp-soft);
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .yp-cv .yp-award p {
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
  }
  .yp-cv .yp-cert-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }
  .yp-cv .yp-cert {
    padding: 1.2rem;
    background: var(--yp-surface);
    border: 1px solid var(--yp-line);
    border-radius: 0.75rem;
    border-top: 3px solid var(--yp-accent);
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .yp-cv .yp-cert-year {
    display: block;
    color: var(--yp-accent);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 0.6rem;
  }
  .yp-cv .yp-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
  }
  .yp-cv .yp-tags li {
    color: var(--yp-ink);
    background: var(--yp-soft);
    border: 1px solid var(--yp-line);
    border-radius: 0.45rem;
    padding: 0.5rem 0.8rem;
    font-size: 0.9375rem;
  }
  @media (max-width: 700px) {
    .yp-cv .yp-cert-grid {
      grid-template-columns: 1fr;
    }
    .yp-cv .yp-timeline {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .yp-cv .yp-detail {
      padding-left: 1rem;
    }
    .yp-cv .yp-hero {
      border-radius: 0.75rem;
    }
  }
  @media print {
    .yp-cv .yp-hero {
      background: white;
      color: black;
      padding: 0 0 1rem;
      border-radius: 0;
    }
    .yp-cv .yp-hero h1,
    .yp-cv .yp-hero p,
    .yp-cv .yp-hero a {
      color: black;
    }
    .yp-cv .yp-cert,
    .yp-cv .yp-award,
    .yp-cv .yp-timeline {
      break-inside: avoid;
    }
  }
</style>

<article class="yp-cv">
  <header class="yp-hero">
    <p class="yp-kicker">Curriculum Vitae</p>
    <h1>{{ cv.name | escape }}</h1>
    <p class="yp-role">{{ cv.label | escape }}</p>
    {% if cv.summary %}
      <p class="yp-summary">{{ cv.summary | escape }}</p>
    {% endif %}
    {% if cv.email %}
      <div class="yp-contact">
        <a href="mailto:{{ cv.email | escape }}">{{ cv.email | escape }}</a>
      </div>
    {% endif %}
  </header>

  {% for section in cv.sections %}
    {% assign section_name = section[0] %}
    {% assign entries = section[1] %}
    <section class="yp-section" aria-labelledby="{{ section_name | slugify }}">
      <div class="yp-section-heading">
        <span class="yp-number" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
        <h2 id="{{ section_name | slugify }}">
          {% case section_name %}
            {% when 'Awards' -%}
              Honors &amp; Scholarships
            {% when 'Experience' -%}
              Clinical Experience
            {% when 'Volunteer' -%}
              Student Activities &amp; Mentoring
            {% when 'Certificates' -%}
              Certifications &amp; Badges
            {% when 'Interests' -%}
              Research Interests
            {% else -%}
              {{- section_name | escape }}
          {% endcase %}
        </h2>
      </div>
      {% if section_name == 'Certificates' %}<div class="yp-cert-grid">{% endif %}
      {% for entry in entries %}
        {% if section_name == 'Certificates' %}
          <div class="yp-cert">
            {% if entry.date -%}
              <span class="yp-cert-year">{{ entry.date | escape }}</span>
            {%- endif %}
            <h3>{{ entry.name | escape }}</h3>
            {% if entry.issuer %}
              <p class="yp-meta">{{ entry.issuer | escape }}</p>
            {% endif %}
          </div>
        {% elsif section_name == 'Awards' %}
          <div class="yp-award">
            <h3>{{ entry.title | escape }}</h3>
            {% if entry.awarder %}
              <p class="yp-meta">{{ entry.awarder | escape }}</p>
            {% endif %}
            {% if entry.summary %}
              <p>{{ entry.summary | escape }}</p>
            {% endif %}
          </div>
        {% elsif section_name == 'Interests' %}
          {% assign interests = entry.keywords | split: ',' %}
          <ul class="yp-tags">
            {% for interest in interests %}
              <li>{{ interest | strip | escape }}</li>
            {% endfor %}
          </ul>
        {% else %}
          <div class="yp-timeline">
            <div class="yp-date">
              {% if entry.start_date %}
                <span>
                  {{- entry.start_date | escape -}}
                  {%- if entry.end_date and entry.end_date != entry.start_date -%}
                    <br>
                    &ndash; {{ entry.end_date | escape -}}
                  {%- endif -%}
                </span>
              {% elsif entry.date %}
                <span>{{ entry.date | escape }}</span>
              {% endif %}
            </div>
            <div class="yp-detail">
              <h3>
                {% if entry.institution -%}
                  {{- entry.institution | escape -}}
                {%- elsif entry.position -%}
                  {{- entry.position | escape -}}
                {%- elsif entry.title -%}
                  {{- entry.title | escape -}}
                {%- else -%}
                  {{- entry.name | escape -}}
                {%- endif %}
              </h3>
              {% if entry.company %}
                <div class="yp-org">{{ entry.company | escape }}</div>
              {% endif %}
              {% if entry.studyType %}
                <div class="yp-org">{{ entry.studyType | escape }} in {{ entry.area | escape }}</div>
              {% endif %}
              {% if entry.location %}
                <p class="yp-meta">{{ entry.location | escape }}</p>
              {% endif %}
              {% if entry.summary %}
                <p class="yp-description">{{ entry.summary | escape }}</p>
              {% endif %}
              {% if entry.highlights %}
                <ul class="yp-highlights">
                  {% for highlight in entry.highlights %}
                    <li>{{ highlight | escape }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
      {% if section_name == 'Certificates' %}</div>{% endif %}
    </section>
  {% endfor %}
</article>
