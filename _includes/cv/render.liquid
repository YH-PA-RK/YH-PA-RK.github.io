<style>
  .folio-cv {
    font-size: 1rem;
    line-height: 1.6;
  }
  .folio-cv .card {
    margin-bottom: 1.5rem;
  }
  .folio-cv .card-title {
    align-self: flex-start;
    width: fit-content;
    max-width: 100%;
    box-sizing: border-box;
    margin-bottom: 1rem;
    padding: 0 0.75rem 0.75rem 0;
    border-bottom: 1px solid var(--global-theme-color);
    scroll-margin-top: 6rem;
  }
  .folio-cv .cv-entry {
    padding: 1rem 0;
    border-bottom: 1px solid var(--global-divider-color);
  }
  .folio-cv .cv-entry:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .folio-cv .card-title + .cv-entry {
    padding-top: 0;
  }
  .folio-cv .cv-dated {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    column-gap: 1.25rem;
  }
  .folio-cv .cv-dated > * {
    grid-column: 2;
    min-width: 0;
  }
  .folio-cv .cv-dated > .cv-date {
    grid-column: 1;
    grid-row: 1 / span 2;
  }
  .folio-cv .cv-date {
    color: var(--global-theme-color);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  .folio-cv .cv-date .badge {
    font-size: 0.875rem;
    padding: 0.35rem 0.5rem;
    white-space: nowrap;
    line-height: 1.4;
  }
  .folio-cv .cv-entry ul {
    margin: 0.6rem 0 0;
    padding-left: 1.25rem;
  }
  .folio-cv .cv-entry li {
    margin-bottom: 0.25rem;
  }
  .folio-cv .cv-entry strong {
    font-weight: 600;
  }
  .folio-cv a {
    overflow-wrap: anywhere;
  }
  .folio-cv .cv-certificates .cv-entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1rem;
    padding: 0.85rem 1rem;
    margin-top: 0.65rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 2px;
  }
  .folio-cv .cv-certificates .card-title + .cv-entry {
    margin-top: 0;
  }
  .folio-cv .cv-certificates .cv-entry > * {
    grid-column: 1;
  }
  .folio-cv .cv-certificates .cv-entry > .cv-date {
    grid-column: 2;
    grid-row: 1;
  }
  .folio-cv .cv-practicum-scroll {
    overflow-x: auto;
  }
  .folio-cv .cv-practicum-scroll:focus-visible {
    outline: 2px solid var(--global-theme-color);
    outline-offset: 2px;
  }
  .folio-cv .cv-practicum-table {
    width: 100%;
    min-width: 36rem;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .folio-cv .cv-practicum-table th,
  .folio-cv .cv-practicum-table td {
    padding: 0.75rem 0.5rem;
    text-align: center;
    vertical-align: middle;
    border-bottom: 1px solid var(--global-divider-color);
  }
  .folio-cv .cv-practicum-table th {
    font-weight: 600;
  }
  .folio-cv .cv-practicum-table th:first-child,
  .folio-cv .cv-practicum-table td:first-child {
    width: 33%;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .folio-cv .cv-practicum-table td:first-child {
    font-size: 0.875rem;
  }
  .folio-cv .cv-practicum-table th:nth-child(2) {
    width: 31%;
  }
  .folio-cv .cv-practicum-table th:last-child,
  .folio-cv .cv-practicum-table td:last-child {
    width: 9%;
    font-weight: 600;
  }
  .folio-cv .cv-practicum-table tr:last-child td {
    border-bottom: 0;
  }
  .folio-cv .cv-practicum-note {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    color: var(--global-text-color-light);
  }
  @media (max-width: 600px) {
    .folio-cv .cv-dated {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }
    .folio-cv .cv-dated > .cv-date {
      order: -1;
    }
  }
</style>
<div class="post folio-cv">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  {% assign cv = site.data.cv.cv %}

  <article>
    <div class="cv">
      {% for section in cv.sections %}
        {% assign section_name = section[0] %}
        {% assign entries = section[1] %}

        <div class="card mt-3 p-3 cv-{{ section_name | slugify }}">
          <h3
            class="card-title font-weight-medium"
            id="{{ section_name | slugify }}"
          >
            {% case section_name %}
              {% when 'Awards' %}
                Honors &amp; Scholarships
              {% when 'Experience' %}
                Clinical Experience
              {% when 'Volunteer' %}
                Student Activities &amp; Mentoring
              {% when 'Certificates' %}
                Certifications &amp; Badges
              {% else %}
                {{ section_name }}
            {% endcase %}
          </h3>

          {% if section_name == 'Clinical Practicum' %}
            <div class="cv-practicum-scroll" role="region" aria-labelledby="clinical-practicum" tabindex="0">
              <table class="cv-practicum-table" aria-labelledby="clinical-practicum" aria-describedby="cv-practicum-note">
                <thead>
                  <tr>
                    <th scope="col">Period</th>
                    <th scope="col">Institution</th>
                    <th scope="col">Clinical Area</th>
                    <th scope="col">Grade</th>
                  </tr>
                </thead>
                <tbody>
                  {% for entry in entries %}
                    <tr>
                      <td>
                        <time datetime="{{ entry.start_date | escape }}">{{ entry.start_date | replace: '-', '.' }}</time
                        >&ndash;<time datetime="{{ entry.end_date | escape }}">{{ entry.end_date | replace: '-', '.' }}</time>
                      </td>
                      <td>{{ entry.institution | escape }}</td>
                      <td>{{ entry.area | escape }}</td>
                      <td>{{ entry.grade | escape }}</td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
            <p class="cv-practicum-note" id="cv-practicum-note">Grades reflect overall course performance; all courses used relative grading.</p>
          {% else %}
            {% for entry in entries %}
              <div class="cv-entry{% if entry.start_date %} cv-dated{% endif %}">
                <div>
                  <strong>
                    {% if entry.institution %}
                      {{ entry.institution | escape }}
                    {% elsif entry.position %}
                      {{ entry.position | escape }}
                    {% elsif entry.title %}
                      {{ entry.title | escape }}
                    {% else %}
                      {{ entry.name | escape }}
                    {% endif %}
                  </strong>
                </div>

                {% if entry.start_date %}
                  <div class="cv-date">
                    <span class="badge font-weight-bold danger-color-dark">
                      {{- entry.start_date | escape -}}
                      {%- if entry.end_date == 'present' %}
                        ~
                      {%- elsif entry.end_date and entry.end_date != entry.start_date %}
                        &ndash; {{ entry.end_date | escape -}}
                      {%- endif -%}
                    </span>
                  </div>
                {% elsif entry.date %}
                  <div class="cv-date">{{ entry.date | escape }}</div>
                {% endif %}
                {% if entry.company %}
                  <div>{{ entry.company | escape }}</div>
                {% endif %}

                {% if entry.studyType %}
                  <div>{{ entry.studyType | escape }} in {{ entry.area | escape }}</div>
                {% endif %}

                {% if entry.location %}
                  <div>{{ entry.location | escape }}</div>
                {% endif %}

                {% if entry.awarder %}
                  <div>{{ entry.awarder | escape }}</div>
                {% endif %}

                {% if entry.issuer %}
                  <div>{{ entry.issuer | escape }}</div>
                {% endif %}

                {% if entry.summary %}
                  <div>{{ entry.summary | escape }}</div>
                {% endif %}

                {% if entry.keywords %}
                  <div>{{ entry.keywords | escape }}</div>
                {% endif %}

                {% if entry.highlights %}
                  <ul>
                    {% for highlight in entry.highlights %}
                      <li>{{ highlight | escape }}</li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            {% endfor %}
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </article>
</div>
